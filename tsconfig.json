{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": ["node", "@rsbuild/core/types"],
    "lib": ["ESNext", "DOM", "WebWorker"]
  },
  "include": ["src", "global.d.ts", "*.config.ts", "scripts/*.mjs"]
}
