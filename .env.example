# API Endpoints
# Trusted internal/origin API used by SSR
API_ENDPOINT=https://origin-api.egdata.app
# Public API endpoint used by client/browser
VITE_API_ENDPOINT=https://api.egdata.app
# Optional fixed /v1 API key (for local/dev testing; overrides ephemeral egw_ browser tokens)
VITE_V1_API_KEY=

# First-party /v1 Authentication & Ephemeral Web Tokens
# Deployments must generate and configure a private 32+ byte shared secret (e.g., `openssl rand -base64 32`)
WEB_EPHEMERAL_KEY_SECRET=
V1_WORKER_TOKEN=
ORIGIN_AUTH_TOKEN=
WEB_PROJECT_ID=prj_egdata_web
WEB_BROWSER_KEY_ID=key_egdata_web_browser
WEB_SSR_KEY_ID=key_egdata_web_ssr

# Static asset CDN (Cloudflare R2)
# ASSET_PREFIX is a BUILD-time variable (baked into the SSR bundle by rsbuild,
# like API_ENDPOINT). Set it as a build environment variable in Coolify:
#   ASSET_PREFIX=https://static.egdata.app
# The remaining variables are runtime-only (read by scripts/start-prod.mjs on boot).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# SYNC_STATIC_BUCKET=egdata-static
# SYNC_STATIC_PRUNE=false
# SYNC_STATIC_REQUIRED=true
